{
  "repo": "github.com/shadybin/shadybin",
  "language": "go",
  "builds": [
    {
      "runner": "ubuntu-24.04",
      "toolchain": {"go": "go.mod"},
      "run": ["make dist"],
      "artifacts": ["dist/shadybin-*"]

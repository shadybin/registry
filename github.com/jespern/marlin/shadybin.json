{
  "repo": "github.com/jespern/marlin",
  "language": "zig",
  "seal": true,
  "builds": [
    {
      "runner": "ubuntu-24.04",
      "toolchain": {
        "zig": "0.17.0"
      },
      "fetch": [
        "curl -fsSL --retry 3 -o \"$RUNNER_TEMP/marlin-zig-x86_64-linux-0.17.0.tar.xz\" https://ziglang.org/download/0.17.0/zig-x86_64-linux-0.17.0.tar.xz && echo \"1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026  $RUNNER_TEMP/marlin-zig-x86_64-linux-0.17.0.tar.xz\" | shasum -a 256 -c - && tar -xJf \"$RUNNER_TEMP/marlin-zig-x86_64-linux-0.17.0.tar.xz\" -C \"$RUNNER_TEMP\"",
        "PATH=\"$RUNNER_TEMP/zig-x86_64-linux-0.17.0:$PATH\" zig build --fetch=all"
      ],
      "run": [
        "PATH=\"$RUNNER_TEMP/zig-x86_64-linux-0.17.0:$PATH\" zig build -Dtarget=x86_64-linux-musl -Doptimize=safe -Dembedded-sqlite=true -Dversion=\"${TAG#v}\"",
        "mkdir -p dist && cp zig-out/bin/marlin dist/marlin-x86_64-linux",
        "mkdir -p dist/package && cp zig-out/bin/marlin LICENSE NOTICE THIRD_PARTY_NOTICES dist/package/ && chmod 755 dist/package/marlin && tar -czf dist/marlin-x86_64-linux.tar.gz -C dist/package marlin LICENSE NOTICE THIRD_PARTY_NOTICES && rm -r dist/package"
      ],
      "artifacts": [
        "dist/marlin-x86_64-linux",
        "dist/marlin-x86_64-linux.tar.gz"
      ]
    },
    {
      "runner": "ubuntu-24.04-arm",
      "toolchain": {
        "zig": "0.17.0"
      },
      "fetch": [
        "curl -fsSL --retry 3 -o \"$RUNNER_TEMP/marlin-zig-aarch64-linux-0.17.0.tar.xz\" https://ziglang.org/download/0.17.0/zig-aarch64-linux-0.17.0.tar.xz && echo \"9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8  $RUNNER_TEMP/marlin-zig-aarch64-linux-0.17.0.tar.xz\" | shasum -a 256 -c - && tar -xJf \"$RUNNER_TEMP/marlin-zig-aarch64-linux-0.17.0.tar.xz\" -C \"$RUNNER_TEMP\"",
        "PATH=\"$RUNNER_TEMP/zig-aarch64-linux-0.17.0:$PATH\" zig build --fetch=all"
      ],
      "run": [
        "PATH=\"$RUNNER_TEMP/zig-aarch64-linux-0.17.0:$PATH\" zig build -Dtarget=aarch64-linux-musl -Doptimize=safe -Dembedded-sqlite=true -Dversion=\"${TAG#v}\"",
        "mkdir -p dist && cp zig-out/bin/marlin dist/marlin-aarch64-linux",
        "mkdir -p dist/package && cp zig-out/bin/marlin LICENSE NOTICE THIRD_PARTY_NOTICES dist/package/ && chmod 755 dist/package/marlin && tar -czf dist/marlin-aarch64-linux.tar.gz -C dist/package marlin LICENSE NOTICE THIRD_PARTY_NOTICES && rm -r dist/package"
      ],
      "artifacts": [
        "dist/marlin-aarch64-linux",
        "dist/marlin-aarch64-linux.tar.gz"
      ]
    },
    {
      "runner": "macos-15-intel",
      "toolchain": {
        "zig": "0.17.0"
      },
      "fetch": [
        "curl -fsSL --retry 3 -o \"$RUNNER_TEMP/marlin-zig-x86_64-macos-0.17.0.tar.xz\" https://ziglang.org/download/0.17.0/zig-x86_64-macos-0.17.0.tar.xz && echo \"4f9a1c5269aa17ebda5e6d3c2b89d6cbf36f7d2b22a0306e9ab98f25f95529c6  $RUNNER_TEMP/marlin-zig-x86_64-macos-0.17.0.tar.xz\" | shasum -a 256 -c - && tar -xJf \"$RUNNER_TEMP/marlin-zig-x86_64-macos-0.17.0.tar.xz\" -C \"$RUNNER_TEMP\"",
        "PATH=\"$RUNNER_TEMP/zig-x86_64-macos-0.17.0:$PATH\" zig build --fetch=all"
      ],
      "run": [
        "PATH=\"$RUNNER_TEMP/zig-x86_64-macos-0.17.0:$PATH\" zig build -Dmacos-sdk=\"$(xcrun --sdk macosx --show-sdk-path)\" -Dtarget=x86_64-macos.13.0 -Doptimize=safe -Dembedded-sqlite=true -Dversion=\"${TAG#v}\"",
        "mkdir -p dist && cp zig-out/bin/marlin dist/marlin-x86_64-darwin",
        "mkdir -p dist/package && cp zig-out/bin/marlin LICENSE NOTICE THIRD_PARTY_NOTICES dist/package/ && chmod 755 dist/package/marlin && tar -czf dist/marlin-x86_64-darwin.tar.gz -C dist/package marlin LICENSE NOTICE THIRD_PARTY_NOTICES && rm -r dist/package"
      ],
      "artifacts": [
        "dist/marlin-x86_64-darwin",
        "dist/marlin-x86_64-darwin.tar.gz"
      ]
    },
    {
      "runner": "macos-15",
      "toolchain": {
        "zig": "0.17.0"
      },
      "fetch": [
        "curl -fsSL --retry 3 -o \"$RUNNER_TEMP/marlin-zig-aarch64-macos-0.17.0.tar.xz\" https://ziglang.org/download/0.17.0/zig-aarch64-macos-0.17.0.tar.xz && echo \"b607e9b9234790a008116ae5bdb71c6243b84b9fb42a53a9e70fde41c06c536a  $RUNNER_TEMP/marlin-zig-aarch64-macos-0.17.0.tar.xz\" | shasum -a 256 -c - && tar -xJf \"$RUNNER_TEMP/marlin-zig-aarch64-macos-0.17.0.tar.xz\" -C \"$RUNNER_TEMP\"",
        "PATH=\"$RUNNER_TEMP/zig-aarch64-macos-0.17.0:$PATH\" zig build --fetch=all"
      ],
      "run": [
        "PATH=\"$RUNNER_TEMP/zig-aarch64-macos-0.17.0:$PATH\" zig build -Dmacos-sdk=\"$(xcrun --sdk macosx --show-sdk-path)\" -Dtarget=aarch64-macos.13.0 -Doptimize=safe -Dembedded-sqlite=true -Dversion=\"${TAG#v}\"",
        "mkdir -p dist && cp zig-out/bin/marlin dist/marlin-aarch64-darwin",
        "mkdir -p dist/package && cp zig-out/bin/marlin LICENSE NOTICE THIRD_PARTY_NOTICES dist/package/ && chmod 755 dist/package/marlin && tar -czf dist/marlin-aarch64-darwin.tar.gz -C dist/package marlin LICENSE NOTICE THIRD_PARTY_NOTICES && rm -r dist/package"
      ],
      "artifacts": [
        "dist/marlin-aarch64-darwin",
        "dist/marlin-aarch64-darwin.tar.gz"
      ]
    }
  ],
  "checksums": "*.sha256",
  "analyze": {
    "exclude": [
      "**/*_test.zig",
      "src/testing/**",
      "docs/**",
      "*.md"
    ]
  },
  "vendored": [
    {
      "path": "vendor/sqlite",
      "name": "sqlite.org/sqlite-amalgamation",
      "version": "3.53.4",
      "url": "https://sqlite.org/2026/sqlite-amalgamation-3530400.zip",
      "sha256": "1e71ddf93849c6a6ecf58b827c0692073d2dd7ee40196158068f7b29f422e87d"
    },
    {
      "path": "vendor/libyaml",
      "name": "github.com/yaml/libyaml",
      "version": "0.2.5",
      "url": "https://github.com/yaml/libyaml/archive/refs/tags/0.2.5.tar.gz",
      "sha256": "fa240dbf262be053f3898006d502d514936c818e422afdcf33921c63bed9bf2e"
    }
  ]
}
